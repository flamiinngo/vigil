# Vigil — Environment Variables
# Copy this file to .env and fill in your values

# ── The Graph (free API key — get at https://thegraph.com/studio/apikeys/) ──
# Required for wallet discovery and Uniswap token data enrichment
GRAPH_API_KEY=your_graph_api_key_here

# ── Node identity ─────────────────────────────────────────────────────────────
NODE_ID=vigil-node-1

# ── Wallet slice (for 2-node setup, defaults work automatically) ───────────────
# WALLET_SLICE_TOTAL=2
# WALLET_SLICE_INDEX=1   (1 for node-1, 2 for node-2)

# ── Consensus parameters ──────────────────────────────────────────────────────
CONSENSUS_WINDOW=3600        # seconds — 1 hour default
CONSENSUS_MIN_NODES=2        # independent nodes required

# ── Ethereum WebSocket RPC (public, no key needed) ────────────────────────────
ETH_WS_URL=wss://ethereum.publicnode.com

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Gensyn AXL ────────────────────────────────────────────────────────────────
AXL_URL=http://localhost:9002

# ── Uniswap auto-swap (optional — off by default) ────────────────────────────
SWAP_ENABLED=false
SWAP_BUDGET_ETH=0.01
ETH_RPC_URL=https://eth.llamarpc.com
# NODE_OPERATOR_PRIVATE_KEY=    # required if SWAP_ENABLED=true

# ── Delphi (not wired up yet) ─────────────────────────────────────────────────
# NODE_OPERATOR_ADDRESS=0xYourAddressHere
